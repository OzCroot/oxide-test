#!/usr/bin/env bash
# Demo commit-msg hook. The subject has to look like: type(scope): text
red=$'\033[31m'; reset=$'\033[0m'
subject="$(head -n 1 "$1")"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'
if ! echo "$subject" | grep -Eq "$pattern"; then
  echo "${red}commit-msg:${reset} the subject must look like type(scope): text"
  echo "  got: $subject"
  exit 1
fi
